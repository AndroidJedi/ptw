+def recover_interrupted_jobs(connection) -> None:
+    """This single worker container owns both execution threads; never replay at boot."""
+    rows = connection.execute("SELECT id,session_id FROM jobs WHERE type='llm_structured' AND status='running' FOR UPDATE").fetchall()
+    for job_id, session_id in rows:
+        connection.execute("UPDATE jobs SET status='failed',error_code='WorkerRestarted',error_message='Worker restarted before result persistence',finished_at=now() WHERE id=%s", (job_id,))
+        connection.execute("UPDATE sessions SET status='failed',updated_at=now() WHERE id=%s", (session_id,))
+        append_event(connection, 'JOB_FAILED', 'commander-worker', status='failed', session_id=session_id, job_id=job_id,
+            payload={'error_type':'WorkerRestarted','stage':'RESULT_PROVIDER'})
+    connection.commit()
+
+
+def main() -> None:
+    signal.signal(signal.SIGTERM, stop)
+    signal.signal(signal.SIGINT, stop)
+    with psycopg.connect(database_url(secrets), connect_timeout=3) as connection:
+        recover_interrupted_jobs(connection)
+    capacity = max(1, min(2, int(os.getenv("PTW_MEDIA_CONCURRENCY", "1"))))
+    extra = None
+    if capacity == 2:
+        extra = threading.Thread(target=worker_loop, kwargs={"media_only": True}, name="media-worker")
+        extra.start()
+    logger.info("Commander worker started with media capacity %s", capacity)
+    worker_loop()
+    if extra:
+        extra.join()
