        "type": "numeric_interpolation",
        "minimum": 0.121,
        "maximum": 0.166,
        "quantize": 0.001
      }
    },
    {
      "slider": "conceptual_novelty",
      "component_key": "tension_accent",
      "path": "params.radius",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0,
        "maximum": 32,
        "quantize": 1
      }
    },
    {
      "slider": "information_density",
      "component_key": "body",
      "path": "frame.height",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.053,
        "maximum": 0.099,
        "quantize": 0.001
      }
    },
    {
      "slider": "information_density",
      "component_key": "body",
      "path": "params.font_size",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 26,
        "maximum": 19,
        "quantize": 1
      }
    },
    {
      "slider": "visual_complexity",
      "component_key": "cta_surface",
      "path": "params.opacity",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.72,
        "maximum": 1,
        "quantize": 0.01
      }
    },
    {
      "slider": "visual_complexity",
      "component_key": "tension_orbit",
      "path": "enabled",
      "rule": {
        "type": "optional_component_threshold",
        "minimum": 55
      }
    }
