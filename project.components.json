{
  "version": 2,
  "global_validation": [["git", "diff", "--check"]],
  "components": [
    {
      "name": "repository-architecture",
      "description": "Component ownership, policy, and canonical documentation",
      "paths": ["project.components.json", "AGENTS.md", "README.md", "DESIGN_RULES.md", "docs/**"],
      "validation": [],
      "extended_validation": []
    },
    {
      "name": "validation-pipeline",
      "description": "Product Briefs, five complete Ad Creatives, real-photo assets, lineage, and dormant Natal source",
      "paths": ["commander/**", "validation_pipeline/**", "natal/**", "skills/product-brief-generator/**", "skills/ad-creative-generator/**", "skills/natal-landing-builder/**", "tests/validation_pipeline/**", "tests/integration/**", "db/**", "docker-compose*.yml", "requirements*.txt"],
      "validation": [
        ["python3", "-m", "unittest", "discover", "-s", "tests/validation_pipeline", "-v"],
        ["python3", "-m", "unittest", "tests.commander.test_telegram_boundary", "-v"],
        ["python3", "-m", "commander.demo", "--output-dir", ".local/commander-demo"],
        ["python3", "-m", "compileall", "-q", "commander", "validation_pipeline", "tests/validation_pipeline"]
      ],
      "extended_validation": []
    },
    {
      "name": "commander-web",
      "description": "Mobile-first React PWA owner interface",
      "paths": ["apps/commander-web/**", "firebase.json", ".firebaserc"],
      "validation": [["npm", "--prefix", "apps/commander-web", "run", "check"]],
      "extended_validation": [["npm", "--prefix", "apps/commander-web", "run", "test:e2e"]]
    },
    {
      "name": "owner-control-plane",
      "description": "Firebase-authenticated owner API, job execution, system operations, and root broker",
      "paths": ["owner_gateway/**", "root_broker/**", "tests/owner_gateway/**", "deploy/owner-control-plane/**", "scripts/reset_ptw.sh"],
      "validation": [
        ["python3", "-m", "unittest", "tests.owner_gateway.test_auth", "tests.owner_gateway.test_control_store", "tests.owner_gateway.test_root_broker", "-v"],
        ["python3", "-m", "compileall", "-q", "owner_gateway", "root_broker", "tests/owner_gateway"]
      ],
      "extended_validation": []
    }
  ]
}
