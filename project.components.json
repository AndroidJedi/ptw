{
  "version": 2,
  "global_validation": [["git", "diff", "--check"]],
  "components": [
    {
      "name": "repository-architecture",
      "description": "Component ownership, policy, and canonical documentation",
      "paths": ["project.components.json", "AGENTS.md", "README.md", "DESIGN_RULES.md", "docs/**"],
      "validation": [],
      "extended_validation": []
    },
    {
      "name": "validation-pipeline",
      "description": "Product Brief validation, standalone Universal Studio, and immutable lineage",
      "paths": ["commander/**", "validation_pipeline/**", "skills/product-brief-generator/**", "skills/studio-tune-local/**", "tests/validation_pipeline/**", "db/**", "docker-compose*.yml", "requirements*.txt"],
      "validation": [
        ["python3", "-m", "unittest", "discover", "-s", "tests/validation_pipeline", "-v"],
        ["python3", "-m", "unittest", "tests.commander.test_telegram_boundary", "-v"],
        ["python3", "-m", "commander.demo", "--output-dir", ".local/commander-demo"],
        ["python3", "-m", "compileall", "-q", "commander", "validation_pipeline", "tests/validation_pipeline"]
      ],
      "extended_validation": []
    },
    {
      "name": "commander-web",
      "description": "Mobile-first React PWA owner interface",
      "paths": ["apps/commander-web/**", "firebase.json", ".firebaserc"],
      "validation": [["npm", "--prefix", "apps/commander-web", "run", "check"]],
      "extended_validation": [["npm", "--prefix", "apps/commander-web", "run", "test:e2e"]]
    },
    {
      "name": "owner-gateway",
      "description": "Firebase-authenticated Product Brief and Universal Studio API gateway",
      "paths": ["owner_gateway/**", "tests/owner_gateway/**", "deploy/owner-gateway/**", "scripts/reset_ptw.sh"],
      "validation": [
        ["python3", "-m", "unittest", "discover", "-s", "tests/owner_gateway", "-v"],
        ["python3", "-m", "compileall", "-q", "owner_gateway", "tests/owner_gateway"]
      ],
      "extended_validation": []
    }
  ]
}
