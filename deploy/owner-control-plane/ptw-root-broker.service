[Unit]
Description=PTW root PTY broker
After=network.target docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/ptw
Environment=PYTHONPATH=/root/ptw
Environment=ROOT_BROKER_SOCKET=/run/ptw-root-broker/control.sock
Environment=ROOT_BROKER_ALLOWED_UID=10002
Environment=ROOT_BROKER_ALLOWED_GID=10002
RuntimeDirectory=ptw-root-broker
RuntimeDirectoryMode=0750
ExecStartPre=/bin/chown root:10002 /run/ptw-root-broker
ExecStartPre=/bin/chmod 0750 /run/ptw-root-broker
ExecStart=/usr/bin/python3 -m root_broker.server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
