# Copy to .env.commander and chmod 600. Never commit the real file.
COMMANDER_DB_PASSWORD=replace-with-a-long-random-password
# On the PTW VPS these values are inherited from /opt/ptw/platform/.env so the
# established @ptw_commander_bot remains the only bot. Set them directly only
# for a standalone installation.
TELEGRAM_BOT_TOKEN=existing-bot-token-for-standalone-install-only
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
COMMANDER_PUBLIC_BASE_URL=https://commander.example.com
COMMANDER_HTTP_PORT=8091
