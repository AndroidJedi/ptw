+def test_two_image_jobs_have_isolated_cli_homes_and_keep_model_quality(monkeypatch, tmp_path):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    barrier = Barrier(2)
+    homes = []
+    monkeypatch.setenv('CONTENT_GRAPHIC_ASSET_DIR', str(tmp_path / 'assets'))
+    def run(command, **kwargs):
+        home = Path(kwargs['env']['CODEX_HOME'])
+        homes.append(home)
+        barrier.wait(timeout=5)
+        Path(command[command.index('--output-last-message')+1]).write_text('{"generated":true}')
+        output = home / 'generated_images' / 'parallel-image'
+        output.mkdir(parents=True)
+        (output / 'image.png').write_bytes(png_header())
+        return subprocess.CompletedProcess(command, 0, stdout=thread_output('parallel-image', image_call=True), stderr='')
+    monkeypatch.setattr('worker.main.subprocess.run', run)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda _: execute_structured_llm(request('content_non_human_graphic_generation', model='gpt-6-astra')), range(2)))
+    assert len(set(homes)) == 2
+    assert all(not home.exists() for home in homes)
+    assert all(result['invocation']['model'] == 'gpt-6-astra' for result in results)
+    assert all(result['image']['width'] == 1254 for result in results)
+
+
+def test_restart_marks_only_abandoned_running_jobs_failed_without_replay(monkeypatch):
+    from worker.main import recover_interrupted_jobs
+    statements = []; events = []
+    class Connection:
+        committed = False
+        def execute(self, sql, args=()):
+            statements.append((sql,args)); return self
+        def fetchall(self): return [(41,10),(42,11)]
+        def commit(self): self.committed = True
+    monkeypatch.setattr('worker.main.append_event', lambda *args,**kwargs:events.append(kwargs))
+    connection = Connection(); recover_interrupted_jobs(connection)
+    assert "status='running' FOR UPDATE" in statements[0][0]
+    assert not any("status='queued'" in sql or "status='completed'" in sql for sql,_ in statements)
+    assert [event['job_id'] for event in events] == [41,42]
+    assert all(event['payload']['error_type']=='WorkerRestarted' for event in events)
+    assert connection.committed
