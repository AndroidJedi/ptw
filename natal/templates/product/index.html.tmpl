<!doctype html>
<html lang="$lang">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="$description"><meta name="theme-color" content="#0c0e12">
  <title>$page_title</title><link rel="icon" href="assets/logo-icon.svg"><link rel="stylesheet" href="styles.css">
</head>
<body data-template="product">
  <a class="skip-link" href="#main">$skip_link</a>
  <header class="site-header"><a class="brand" href="#top" aria-label="Natal"><img src="assets/logo-natal.png" alt="Natal" width="300" height="102"></a><nav><a href="#features">$nav_features</a><a href="#how">$nav_how</a><a class="button button-small" href="$cta_url">$cta_label</a></nav></header>
  <main id="main">
    <section class="hero product-hero" id="top" data-landing-block="hero"><div class="hero-copy"><p class="eyebrow">$hero_eyebrow</p><h1>$hero_title</h1><p class="hero-lede">$hero_body</p><a class="button" href="$cta_url">$hero_cta_label <span>→</span></a><dl class="audience-pain" data-landing-block="problem"><div><dt>$audience_label</dt><dd>$problem_body</dd></div><div><dt>$problem_eyebrow</dt><dd>$problem_title</dd></div></dl></div><div class="product-visual" aria-hidden="true"><div class="visual-top"><img src="assets/logo-icon.svg" alt=""><span>Natal workspace</span><i></i></div><div class="visual-metrics"><span></span><span></span><span></span></div><div class="visual-chart"><b></b><b></b><b></b><b></b><b></b><b></b></div><div class="visual-action">Natal · automatic next step</div></div></section>
    <section class="section" id="features" data-landing-block="features"><header class="section-heading"><p class="eyebrow">$features_eyebrow</p><h2>$features_title</h2></header><div class="feature-grid">$feature_cards</div></section>
    <section class="section split-band" id="how" data-landing-block="steps"><div><p class="eyebrow">$steps_eyebrow</p><h2>$steps_title</h2></div><ol class="steps">$steps</ol></section>
    <section class="section proof" data-landing-block="proof"><header class="section-heading"><p class="eyebrow">$proof_eyebrow</p><h2>$proof_title</h2></header><ul>$proof_points</ul></section>
    <section class="section faq" id="faq" data-landing-block="faq"><header class="section-heading"><p class="eyebrow">$faq_eyebrow</p><h2>$faq_title</h2></header>$faq_items</section>
    <section class="final-cta" id="contact" data-landing-block="final_cta"><img src="assets/logo-icon.svg" alt=""><h2>$final_title</h2><p>$final_body</p><a class="button" href="$cta_url">$final_cta_label <span>→</span></a></section>
    $lead_form
  </main>
  <footer><img src="assets/logo-natal.png" alt="Natal"><span>© <span data-year></span> Natal</span></footer><script src="app.js"></script>
</body></html>
