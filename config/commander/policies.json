{
  "version": 1,
  "emergencyStop": false,
  "approvals": {
    "productBriefPromiseAndOffer": true,
    "skillLessonPromotion": true,
    "deployment": true,
    "productionResetPhrase": "RESET PTW PRODUCTION"
  },
  "heavyOperations": {
    "globalConcurrentMaximum": 1,
    "kinds": ["product_brief", "content_result"]
  },
  "telegram": {
    "reuseExistingBotOnly": true,
    "allowedInboundCommands": ["/help", "/status", "/stop"],
    "additionalPollers": false
  },
  "deployment": {
    "productionBranch": "main",
    "directPush": false,
    "recordReleaseTag": true
  }
}
