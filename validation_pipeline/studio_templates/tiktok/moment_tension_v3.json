  "tuning_rules": [
    {
      "slider": "hook_pressure",
      "component_key": "headline",
      "path": "params.font_size",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 50,
        "maximum": 72,
        "quantize": 1
      }
    },
    {
      "slider": "hook_pressure",
      "component_key": "headline",
      "path": "params.font_weight",
      "rule": {
        "type": "enumerated_steps",
        "steps": [
          {
            "minimum": 0,
            "value": 500
          },
          {
            "minimum": 45,
            "value": 600
          },
          {
            "minimum": 70,
            "value": 700
          },
          {
            "minimum": 90,
            "value": 800
          }
        ]
      }
    },
