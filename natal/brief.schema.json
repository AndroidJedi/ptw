{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proove-them-wrong.com/schemas/natal-landing-brief-v1.json",
  "title": "Natal Landing Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["business_idea", "target_audience", "pain", "promise", "key_features", "steps", "cta", "language"],
  "properties": {
    "schema_version": {"const": 1},
    "brand": {"const": "Natal"},
    "language": {"enum": ["uk", "en"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "laval_run_id": {"type": "string", "maxLength": 100},
        "thesis_id": {"type": "string", "maxLength": 100}
      }
    },
    "business_idea": {"type": "string", "minLength": 1, "maxLength": 500},
    "target_audience": {"type": "string", "minLength": 1, "maxLength": 500},
    "pain": {"type": "string", "minLength": 1, "maxLength": 1000},
    "promise": {"type": "string", "minLength": 1, "maxLength": 1000},
    "key_features": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {"$ref": "#/$defs/titledCopy"}
    },
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {"$ref": "#/$defs/titledCopy"}
    },
    "proof_points": {
      "type": "array", "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 280}
    },
    "faq": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": {"type": "string", "minLength": 1, "maxLength": 240},
          "answer": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "cta": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 100},
        "url": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  },
  "$defs": {
    "titledCopy": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "minLength": 1, "maxLength": 600}
      }
    }
  }
}
