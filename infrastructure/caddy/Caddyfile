{
    admin off
}

(security_headers) {
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

{$COMMANDER_PUBLIC_HOST} {
    import security_headers
    encode zstd gzip

    @health {
        method GET
        path /health /healthz
    }
    handle @health {
        reverse_proxy ptw-owner-gateway:8088
    }

    handle {
        reverse_proxy ptw-owner-gateway:8088
    }
}

# Loopback-only operator diagnostic listener. Docker publishes this on 127.0.0.1.
:8080 {
    import security_headers
    @health path /health /health/live /health/ready
    handle @health {
        reverse_proxy commander-api:8000
    }
    handle {
        respond "Not Found" 404
    }
}
