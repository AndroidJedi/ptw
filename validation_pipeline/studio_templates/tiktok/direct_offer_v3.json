  "tuning_rules": [
    {
      "slider": "hook_pressure",
      "component_key": "headline",
      "path": "params.font_size",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 54,
        "maximum": 80,
        "quantize": 1
      }
    },
    {
      "slider": "hook_pressure",
      "component_key": "headline",
      "path": "params.font_weight",
      "rule": {
        "type": "enumerated_steps",
        "steps": [
          {
            "minimum": 0,
            "value": 600
          },
          {
            "minimum": 45,
            "value": 700
          },
          {
            "minimum": 75,
            "value": 800
          },
          {
            "minimum": 92,
            "value": 900
          }
        ]
      }
    },
    {
      "slider": "hook_pressure",
      "component_key": "attention_bar",
      "path": "frame.width",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.061,
        "maximum": 0.182,
        "quantize": 0.001
      }
    },
    {
      "slider": "emotional_intensity",
      "component_key": "hero_media",
      "path": "frame.height",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.32,
        "maximum": 0.46,
        "quantize": 0.001
      }
    },
    {
      "slider": "emotional_intensity",
      "component_key": "hero_media",
      "path": "params.opacity",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.72,
        "maximum": 1,
        "quantize": 0.01
      }
    },
    {
      "slider": "conceptual_novelty",
      "component_key": "media_card",
      "path": "frame.x",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.516,
        "maximum": 0.577,
        "quantize": 0.001
      }
    },
    {
      "slider": "conceptual_novelty",
      "component_key": "hero_media",
      "path": "params.radius",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 6,
        "maximum": 50,
        "quantize": 1
      }
    },
    {
      "slider": "information_density",
      "component_key": "body",
      "path": "frame.height",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.049,
        "maximum": 0.091,
        "quantize": 0.001
      }
    },
    {
      "slider": "information_density",
      "component_key": "body",
      "path": "params.font_size",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 25,
        "maximum": 18,
        "quantize": 1
      }
    },
    {
      "slider": "visual_complexity",
      "component_key": "media_card",
      "path": "params.opacity",
      "rule": {
        "type": "numeric_interpolation",
        "minimum": 0.62,
        "maximum": 1,
        "quantize": 0.01
      }
    },
    {
      "slider": "visual_complexity",
      "component_key": "corner_accent",
      "path": "enabled",
      "rule": {
        "type": "optional_component_threshold",
        "minimum": 50
      }
    }
  ]
