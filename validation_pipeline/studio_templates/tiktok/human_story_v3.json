      "component_key": "headline",
      "path": "params.font_weight",
      "rule": {
        "type": "enumerated_steps",
        "steps": [
          {
            "minimum": 0,
            "value": 400
          },
          {
            "minimum": 40,
            "value": 500
          },
          {
            "minimum": 65,
            "value": 600
          },
          {
            "minimum": 85,
