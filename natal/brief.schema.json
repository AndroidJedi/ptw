{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proove-them-wrong.com/schemas/natal-landing-brief-v2.json",
  "title": "Natal Landing Brief v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand", "language", "source", "privacy_policy_url", "business_idea", "target_audience", "pain", "promise", "honest_limitation", "key_features", "steps", "proof_points", "faq", "cta"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "brand": {"type": "string", "const": "Natal"},
    "language": {"type": "string", "enum": ["uk", "en"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["positioning_project_id", "positioning_revision_id"],
      "properties": {
        "positioning_project_id": {"type": "string", "format": "uuid"},
        "positioning_revision_id": {"type": "string", "format": "uuid"}
      }
    },
    "privacy_policy_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000},
    "business_idea": {"type": "string", "minLength": 1, "maxLength": 500},
    "target_audience": {"type": "string", "minLength": 1, "maxLength": 500},
    "pain": {"type": "string", "minLength": 1, "maxLength": 1000},
    "promise": {"type": "string", "minLength": 1, "maxLength": 1000},
    "honest_limitation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "key_features": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/titledCopy"}},
    "steps": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/titledCopy"}},
    "proof_points": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 280}},
    "faq": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/faq"}},
    "cta": {
      "type": "object", "additionalProperties": false, "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 100},
        "url": {"type": "string", "const": "#lead-form"}
      }
    }
  },
  "$defs": {
    "titledCopy": {
      "type": "object", "additionalProperties": false, "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "minLength": 1, "maxLength": 600}
      }
    },
    "faq": {
      "type": "object", "additionalProperties": false, "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 240},
        "answer": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
